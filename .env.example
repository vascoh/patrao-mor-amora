# ──────────── Supabase ────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only — usada pelas API routes para mutações privilegiadas (export CSV, etc.)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ──────────── Site / Negócio ────────────
NEXT_PUBLIC_SITE_URL=https://patraomor.pt
NEXT_PUBLIC_WHATSAPP_NUMBER=351912345678
NEXT_PUBLIC_CONTACT_EMAIL=geral@patraomor.pt
NEXT_PUBLIC_CONTACT_PHONE=212345678

# ──────────── Redes Sociais (opcional — oculto se não definido) ────────────
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# ──────────── SEO ────────────
# Google Search Console verification token
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# ──────────── Tracking (opcional) ────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ──────────── Netlify (CI/CD) ────────────
# Netlify build hook URL — set in GitHub repo vars as NETLIFY_BUILD_HOOK_URL
# https://app.netlify.com/sites/YOUR-SITE/settings/deploys#build-hooks
